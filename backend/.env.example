# Local database path. Keep the database file out of version control.
EMERGENZIX_DB_PATH=../data/emergenzix.db

# Simulated account only. These are not exchange account credentials.
EMERGENZIX_INITIAL_PAPER_CASH=100000
EMERGENZIX_MAX_ORDER_NOTIONAL=5000
EMERGENZIX_PAPER_FEE_BPS=10

# Optional Binance SPOT account visibility. Use a read-only, IP-restricted key
# with withdrawals disabled. Prefer Docker secret files in deployed systems.
# EMERGENZIX_BINANCE_API_KEY_FILE=/run/secrets/binance_api_key
# EMERGENZIX_BINANCE_API_SECRET_FILE=/run/secrets/binance_api_secret
EMERGENZIX_BINANCE_RECV_WINDOW_MS=5000
