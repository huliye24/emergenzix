[Unit]
Description=Emergenzix immutable classic-strategy research schedule (CPU)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/emergenzix-research/current
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/emergenzix-research/venvs/cpu/bin/python ops/research_compute_dispatcher.py --plan /etc/emergenzix/research-compute-plan.json --node-class cpu --job classic-turtle-matrix --python /opt/emergenzix-research/venvs/cpu/bin/python --repo-root /opt/emergenzix-research/current --data-root /var/lib/emergenzix/research-data/current --run-root /var/lib/emergenzix/research-runs --execute
Nice=10
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

