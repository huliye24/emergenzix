[Unit]
Description=Emergenzix six-hour strategy evidence briefing
Wants=network-online.target
After=network-online.target mihomo.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/emergenzix-ai-current
ExecStart=/home/ubuntu/emergenzix-ai-current/ops/run_ai_research_report.sh
Environment=EMERGENZIX_DEEPSEEK_MODEL=deepseek-flash
Environment=EMERGENZIX_FOLLOW_TELEGRAM_CHAT_ID=-5540864699
Environment=HTTP_PROXY=http://127.0.0.1:7890
Environment=HTTPS_PROXY=http://127.0.0.1:7890
Environment=ALL_PROXY=http://127.0.0.1:7890
Environment=NO_PROXY=127.0.0.1,localhost
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/.local/share/emergenzix-ai

[Install]
WantedBy=multi-user.target
