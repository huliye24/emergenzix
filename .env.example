# Product version used for local image tags; this is not a verified release.
EMERGENZIX_VERSION=0.1.0

# Bind the web UI to localhost by default. Do not expose publicly before security review.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000

# Paper account defaults only. These are not exchange credentials.
EMERGENZIX_INITIAL_PAPER_CASH=100000
EMERGENZIX_MAX_ORDER_NOTIONAL=5000
EMERGENZIX_PAPER_FEE_BPS=10

# Public OHLCV cache: short TTL; set TTL to 0 to disable.
EMERGENZIX_MARKET_DATA_CACHE_TTL_SECONDS=30
EMERGENZIX_MARKET_DATA_CACHE_MAX_ENTRIES=256

# Paper-only watch agent. It uses public OHLCV and emits JSON events to stdout.
EMERGENZIX_WATCH_EXCHANGE=binance
EMERGENZIX_WATCH_SYMBOL=BTCUSDT
EMERGENZIX_WATCH_TIMEFRAME=4h
EMERGENZIX_WATCH_LIMIT=200
EMERGENZIX_WATCH_LOOKBACK=20
EMERGENZIX_WATCH_INTERVAL_SECONDS=300

# Telegram delivery for the unattended watcher. Never commit real values.
# Docker Compose requires Telegram by default; set false only for local log-only development.
EMERGENZIX_TELEGRAM_REQUIRED=true
EMERGENZIX_TELEGRAM_BOT_TOKEN=
EMERGENZIX_TELEGRAM_CHAT_ID=

# Durable Telegram outbox database (inside the persistent Docker data volume).
EMERGENZIX_NOTIFICATION_DB_PATH=/data/notification-outbox.sqlite3


# Watcher operational alerts: deduplicate incidents and send recovery notifications.
# Alert when the pending Telegram outbox reaches this count (minimum 1).
EMERGENZIX_NOTIFICATION_BACKLOG_THRESHOLD=20
EMERGENZIX_OPERATIONAL_ALERT_STATE_PATH=/data/operational-alert-state.json
